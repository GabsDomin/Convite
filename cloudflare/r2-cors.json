{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://gab-naia.online",
          "http://127.0.0.1:3000",
          "http://localhost:3000"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Cache-Control"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
